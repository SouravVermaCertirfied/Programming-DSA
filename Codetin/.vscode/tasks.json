{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Active File",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "if \"${fileExtname}\"==\".c\" (gcc -g \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\") else (g++ -g \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\")"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}