{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run External Console",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/Software/mingw/bin/gdb.exe",
      "preLaunchTask": "${fileExt == '.c' ? 'Build C File (gcc)' : 'Build C++ File (g++)'}",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
