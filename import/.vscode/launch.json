{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug / Run C++ (MinGW x86)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": true,                // 🟢 Opens a real terminal for output
      "MIMode": "gdb",
      "miDebuggerPath": "D:/Software/mingw/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C/C++: g++.exe build active file"
    }
  ]
}